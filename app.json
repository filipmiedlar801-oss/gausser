{
  "expo": {
    "name": "Gaussian Scanner",
    "slug": "gaussian-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gaussianscanner",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.filipor.gaussianscanner",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja używa kamery i ARKit do skanowania pomieszczeń i zbierania zdjęć do treningu gaussian splatów.",
        "UIRequiredDeviceCapabilities": ["arkit"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
